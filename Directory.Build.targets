<Project>
  <!--
    Mirror of the C++-project gate in Directory.Build.props: vcpkg's
    MSBuild integration is C++ specific. Without the extension check
    we get MSB4011 duplicate-import warnings when .NET projects
    (HorizonRadio.UI.csproj) are restored or built from this tree.
  -->
  <Import Project="$(MSBuildThisFileDirectory)vcpkg\scripts\buildsystems\msbuild\vcpkg.targets"
          Condition="'$(MSBuildProjectExtension)' == '.vcxproj' and exists('$(MSBuildThisFileDirectory)vcpkg\scripts\buildsystems\msbuild\vcpkg.targets')" />
</Project>
