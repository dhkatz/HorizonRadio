<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:views="using:HorizonRadio.UI.Views"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="HorizonRadio.UI.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel">

    <Design.DataContext>
        <vm:NowPlayingViewModel />
    </Design.DataContext>

    <!-- Expanded "now playing" view: just the large art + metadata. Transport,
         source/output pickers, and volume live in the persistent player bar
         (PlayerBarView) so they're available on every tab. -->
    <Grid Margin="24">
        <Border Classes="Card"
                Padding="32"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
            <views:TrackInfoView />
        </Border>
    </Grid>
</UserControl>
