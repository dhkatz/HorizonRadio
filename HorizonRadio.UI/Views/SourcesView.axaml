<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="HorizonRadio.UI.Views.SourcesView"
             x:DataType="vm:SourcesViewModel">

    <Design.DataContext>
        <vm:SourcesViewModel />
    </Design.DataContext>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:DirectoryFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding Path, Mode=TwoWay}"
                             PlaceholderText="Pick a folder..." />
                    <Button Grid.Column="1"
                            Classes="Outline"
                            Content="Browse"
                            Margin="6,0,0,0"
                            Click="BrowseDirectory_Click"
                            Tag="{Binding}"/>
                </Grid>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FileFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding Path, Mode=TwoWay}"
                             PlaceholderText="Pick a file..." />
                    <Button Grid.Column="1"
                            Classes="Outline"
                            Content="Browse"
                            Margin="6,0,0,0"
                            Click="BrowseFile_Click"
                            Tag="{Binding}"/>
                </Grid>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToolFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>

                <ComboBox ItemsSource="{Binding Available}"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="ToolPick_SelectionChanged"
                          Tag="{Binding}"
                          IsVisible="{Binding HasAvailable}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{DynamicResource MutedColor}"
                                        CornerRadius="4"
                                        Padding="6,1">
                                    <TextBlock Text="Installed"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundColor}"/>
                                </Border>
                                <TextBlock Text="{Binding Path}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding Path, Mode=TwoWay}"
                             PlaceholderText="Or paste a custom path..." />
                    <Button Grid.Column="1"
                            Classes="Outline"
                            Content="Browse"
                            Margin="6,0,0,0"
                            Click="BrowseTool_Click"
                            Tag="{Binding}"/>
                </Grid>

                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Text="Not installed. Open the Tools tab to download."
                           FontSize="11" Opacity="0.55"
                           IsVisible="{Binding !HasAvailable}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <TextBox Text="{Binding Text, Mode=TwoWay}"
                         PlaceholderText="{Binding Placeholder}"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BoolFieldViewModel}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="11" Opacity="0.55"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding IsOn, Mode=TwoWay}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EnumFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto">

            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock Text="Audio Source" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Pick what plays through the in-game radio."
                           FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <Border Grid.Row="1" Classes="Card" Padding="16" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Source" FontSize="12" FontWeight="Medium" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding AvailableSources}"
                              SelectedItem="{Binding SelectedFactory, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedFactory.Description}"
                               FontSize="11" Opacity="0.6"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SelectedFactory.Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <Separator Margin="0,6"/>

                    <TextBlock Text="Replace station" FontSize="12" FontWeight="Medium" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding Stations}"
                              SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Which in-game station Horizon Radio takes over. “Any station” replaces whichever one you tune to; pick a specific station to leave the rest as the game's own music."
                               FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="Card" Padding="16" Margin="0,0,0,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="Configuration" FontSize="12" FontWeight="Medium" Opacity="0.7"/>
                    <ItemsControl ItemsSource="{Binding CurrentSchema}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="14"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="(This source has no settings.)"
                               FontSize="11" Opacity="0.5" FontStyle="Italic"
                               IsVisible="{Binding HasNoSchema}"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3"
                       Text="{Binding StatusMessage}"
                       FontSize="11"
                       Margin="0,0,0,12"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
                    </Style>
                </TextBlock.Styles>
            </TextBlock>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="Secondary"
                        Content="Stop"
                        Command="{Binding StopCommand}"
                        IsVisible="{Binding IsRunning}"/>
                <Button Classes="Primary"
                        Content="Start"
                        Command="{Binding StartCommand}"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
