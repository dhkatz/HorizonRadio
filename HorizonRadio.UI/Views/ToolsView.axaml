<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="HorizonRadio.UI.Views.ToolsView"
             x:DataType="vm:ToolsViewModel">

    <Design.DataContext>
        <vm:ToolsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <StackPanel Spacing="4" Margin="0,0,0,4">
                <TextBlock Text="Tools" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Install the external binaries some sources depend on."
                           FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolItemViewModel}">
                        <!-- Everything in the body so layout sits inside
                             the card's content padding consistently.
                             The Header/Footer slots were giving the
                             header content (icon + title) different
                             left padding than the body, making the icon
                             look flush against the card border. -->
                        <shadui:Card Width="340"
                                     Margin="0,0,16,16"
                                     HasShadow="True">
                            <StackPanel Spacing="14">

                                <!-- Title row: icon + title block + status pill -->
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      RowDefinitions="Auto,Auto">
                                    <Border Grid.Column="0" Grid.RowSpan="2"
                                            Width="38" Height="38"
                                            CornerRadius="999"
                                            Background="{Binding StatusBrush}"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Toolbox"
                                                                    Width="20" Height="20"
                                                                    Foreground="White"/>
                                    </Border>

                                    <shadui:CardTitle Grid.Column="1" Grid.Row="0"
                                                      Content="{Binding DisplayName}"
                                                      VerticalAlignment="Center"/>

                                    <Border Grid.Column="2" Grid.Row="0"
                                            Background="{DynamicResource SecondaryColor}"
                                            CornerRadius="999"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundColor}"/>
                                    </Border>

                                    <shadui:CardDescription Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                            Content="{Binding Description}"
                                                            Margin="0,2,0,0"/>
                                </Grid>

                                <Border Background="{DynamicResource SecondaryColor}"
                                        CornerRadius="6"
                                        Padding="8,6"
                                        IsVisible="{Binding HasSha}"
                                        ToolTip.Tip="{Binding ShaFull}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ShieldCheck"
                                                                    Width="14" Height="14"
                                                                    Foreground="#22c55e"
                                                                    VerticalAlignment="Center"/>
                                        <TextBlock Text="Verified"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource SecondaryForegroundColor}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="·"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundColor}"
                                                   Opacity="0.6"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ShaShort}"
                                                   FontSize="10"
                                                   FontFamily="Consolas,Cascadia Mono,monospace"
                                                   Foreground="{DynamicResource SecondaryForegroundColor}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="4"
                                            IsVisible="{Binding IsWorking}">
                                    <ProgressBar Minimum="0" Maximum="1"
                                                 Value="{Binding ProgressFraction}"
                                                 IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                                 Height="6"/>
                                    <TextBlock Text="{Binding ProgressText}"
                                               FontSize="11"
                                               Opacity="0.65"/>
                                </StackPanel>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           FontSize="11"
                                           Foreground="#ef4444"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Right">
                                    <Button Classes="Ghost"
                                            Content="Cancel"
                                            Command="{Binding CancelCommand}"
                                            IsVisible="{Binding IsWorking}"/>
                                    <Button Classes="Destructive"
                                            Content="Uninstall"
                                            Command="{Binding UninstallCommand}"
                                            IsEnabled="{Binding CanUninstall}"
                                            IsVisible="{Binding IsInstalled}"/>
                                    <Button Classes="Primary"
                                            Content="{Binding InstallButtonLabel}"
                                            Command="{Binding InstallCommand}"
                                            IsEnabled="{Binding CanInstall}"/>
                                </StackPanel>

                            </StackPanel>
                        </shadui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
