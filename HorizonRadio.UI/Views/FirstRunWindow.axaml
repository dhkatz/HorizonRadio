<shadui:Window xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:HorizonRadio.UI.ViewModels"
               xmlns:views="using:HorizonRadio.UI.Views"
               xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="420"
               x:Class="HorizonRadio.UI.Views.FirstRunWindow"
               x:DataType="vm:FirstRunViewModel"
               Title="Horizon Radio"
               TitleFontWeight="SemiBold"
               Width="560" Height="420"
               CanResize="False"
               WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:FirstRunViewModel />
    </Design.DataContext>

    <Grid Margin="28,20,28,24" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="Welcome to Horizon Radio" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Which game do you play? You can change this later in Settings → Game."
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>

        <views:GameChoiceView Grid.Row="1" DataContext="{Binding Choice}"/>

        <Button Grid.Row="2" Classes="Primary" Content="Continue"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                Command="{Binding ContinueCommand}"/>
    </Grid>
</shadui:Window>
