<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="380"
             x:Class="HorizonRadio.UI.Views.QuickPlayDialogView"
             x:DataType="vm:QuickPlayDialogViewModel">

    <Design.DataContext>
        <vm:QuickPlayDialogViewModel />
    </Design.DataContext>

    <StackPanel Margin="24" Spacing="16" Width="380">
        <StackPanel Spacing="4">
            <TextBlock Classes="h4" Text="Quick Play" />
            <TextBlock Text="{Binding SourceName, StringFormat='Play a one-off from {0} — a URL, folder, or file. For a saved cross-source playlist, build a Mix.'}"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <TextBox Classes="Clearable"
                 Text="{Binding Locator, Mode=TwoWay}"
                 PlaceholderText="{Binding Hint}"
                 shadui:ControlAssist.Label="What to play"
                 shadui:ElementAssist.FocusOnLoad="True" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Classes="Outline" Content="Cancel" Command="{Binding CancelCommand}" HotKey="Escape" />
            <Button Classes="Primary" Content="Play" Command="{Binding PlayCommand}" HotKey="Enter" />
        </StackPanel>
    </StackPanel>
</UserControl>
