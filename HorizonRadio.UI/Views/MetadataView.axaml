<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="HorizonRadio.UI.Views.MetadataView"
             x:DataType="vm:MetadataViewModel">

    <Design.DataContext>
        <vm:MetadataViewModel/>
    </Design.DataContext>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:DirectoryFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <TextBox Text="{Binding Path, Mode=TwoWay}" PlaceholderText="Pick a folder..."/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <TextBox Text="{Binding Text, Mode=TwoWay}"
                         PlaceholderText="{Binding Placeholder}"
                         PasswordChar="{Binding PasswordChar}"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BoolFieldViewModel}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn, Mode=TwoWay}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EnumFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto">

            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock Text="Metadata Provider" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Where to look up album art, canonical titles, and other extras after each track change."
                           FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Classes="Card" Padding="16" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Provider" FontSize="12" FontWeight="Medium" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding AvailableProviders}"
                              SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedProvider.Description}"
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedProvider.Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="Card" Padding="16" Margin="0,0,0,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="Configuration" FontSize="12" FontWeight="Medium" Opacity="0.7"/>
                    <ItemsControl ItemsSource="{Binding CurrentSchema}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="14"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="(This provider has no settings.)"
                               FontSize="11" Opacity="0.5" FontStyle="Italic"
                               IsVisible="{Binding HasNoSchema}"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3"
                       Text="{Binding StatusMessage}"
                       FontSize="11"
                       Margin="0,0,0,12"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="Primary"
                        Content="Apply"
                        Command="{Binding ApplyCommand}"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
