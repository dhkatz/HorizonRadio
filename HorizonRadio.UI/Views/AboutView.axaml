<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="HorizonRadio.UI.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <Design.DataContext>
        <vm:AboutViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

            <StackPanel Spacing="4" Margin="0,0,0,4">
                <TextBlock Text="About" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Version, updates, and links."
                           FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <!-- App identity + update -->
            <Border Classes="Card" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="38" Height="38"
                                CornerRadius="999"
                                Background="#6366f1"
                                VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Radio"
                                                        Width="20" Height="20"
                                                        Foreground="White"/>
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Horizon Radio" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding VersionLine}" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource SecondaryColor}"
                            CornerRadius="6"
                            Padding="10,8"
                            IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundColor}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding CanCheck}">
                        <Button Classes="Primary"
                                Content="Update Now"
                                Command="{Binding UpdateCommand}"
                                IsVisible="{Binding UpdateButtonVisible}"/>
                        <Button Classes="Ghost"
                                Content="{Binding CheckLabel}"
                                Command="{Binding CheckCommand}"
                                IsEnabled="{Binding !IsChecking}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Links -->
            <Border Classes="Card" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Links" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="Ghost" Content="GitHub" Command="{Binding OpenRepoCommand}"/>
                        <Button Classes="Ghost" Content="Releases" Command="{Binding OpenReleasesCommand}"/>
                        <Button Classes="Ghost" Content="Report an Issue" Command="{Binding OpenIssuesCommand}"/>
                        <Button Classes="Ghost" Content="License" Command="{Binding OpenLicenseCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Diagnostics / developer -->
            <Border Classes="Card" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Diagnostics" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Developer tools for troubleshooting metadata issues."
                                   FontSize="12" Opacity="0.6"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Capture Metadata Diagnostics" FontSize="13"/>
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="Logs each song's raw title, the title-model extraction, and every metadata provider's result to a file you can attach to a bug report. Off by default; song titles and artists are recorded — no account credentials."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding IsDiagnosticsEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="Ghost" Content="Open Diagnostics Folder"
                                Command="{Binding OpenDiagnosticsFolderCommand}"/>
                        <TextBlock Text="{Binding DiagnosticsFolder}" FontSize="11" Opacity="0.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
