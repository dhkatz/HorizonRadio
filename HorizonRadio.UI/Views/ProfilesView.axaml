<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:views="using:HorizonRadio.UI.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="HorizonRadio.UI.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">

    <Design.DataContext>
        <vm:ProfilesViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Profiles" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Saved presets that each bundle a source and its config. Switch between them in one click."
                               FontSize="12" Opacity="0.6"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="Primary" Content="New Profile"
                        VerticalAlignment="Center"
                        Command="{Binding NewCommand}"
                        IsVisible="{Binding !IsEditing}"/>
            </Grid>

            <!-- List of profiles -->
            <StackPanel Spacing="0" IsVisible="{Binding !IsEditing}">
                <TextBlock Text="No profiles yet. Click “New Profile” to create one."
                           FontSize="12" Opacity="0.5" Margin="2,4"
                           IsVisible="{Binding !HasProfiles}"/>

                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileRow}">
                            <Border Classes="Card" Padding="14" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Border Padding="8,2" CornerRadius="999"
                                                    Background="{DynamicResource PrimaryColor}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceDisplay}"
                                                           FontSize="10" FontWeight="Medium"
                                                           Foreground="{DynamicResource PrimaryForegroundColor}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="11" Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasSummary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Classes="Primary" Content="Play" Command="{Binding PlayCommand}"/>
                                        <Button Classes="Outline" Content="Edit" Command="{Binding EditCommand}"/>
                                        <Button Classes="Ghost" Command="{Binding DeleteCommand}"
                                                Padding="8" ToolTip.Tip="Delete profile">
                                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Inline editor -->
            <Border Classes="Card" Padding="16" IsVisible="{Binding IsEditing}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Profile" FontSize="14" FontWeight="SemiBold"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Name" FontSize="12" FontWeight="Medium"/>
                        <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                 PlaceholderText="e.g. Chill Mix"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Source" FontSize="12" FontWeight="Medium"/>
                        <ComboBox ItemsSource="{Binding AvailableSources}"
                                  SelectedItem="{Binding EditingSource, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <views:ConfigFormView Fields="{Binding EditFields}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="Secondary" Content="Cancel" Command="{Binding CancelCommand}"/>
                        <Button Classes="Primary" Content="Save" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status: Save validation and Play feedback both surface here. -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
