<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Multi-resolution icon for the .exe (taskbar, alt-tab,
             Explorer). Generated by tools/IconGen — re-run that
             project to refresh after a design change. -->
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
        <PackageReference Include="ShadUI" Version="0.2.3" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-570" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\HorizonRadio.Core\HorizonRadio.Core.csproj" />
    </ItemGroup>

    <!--
      Pull C++-side build outputs into the UI's bin directory so the
      Spotify source's auto-discovery (SpotifyLibrespotSourceFactory.
      DiscoverLibrespotExe) finds librespot.exe without the user having
      to file-pick it, and so the release zip can be assembled from a
      single output dir.

      Path notes:
        - librespot.exe lives in build/Librespot/bin/ regardless of
          configuration — cargo install always emits Release.
        - version.dll has separate Debug / Release build outputs; we
          always copy from Release because Debug version.dll isn't
          useful (FH6 doesn't reload a CRT-debug-DLL).

      Each item is gated on Exists() so a fresh checkout that hasn't
      built the C++ side yet still produces a buildable UI — the user
      just won't get auto-discovery / a bundled DLL until they run the
      C++ build (HorizonRadio.slnx) at least once.

      ProjectReference to the vcxprojs is intentionally NOT used: a
      csproj→vcxproj reference re-triggers the MSB4236 SDK resolver
      mess that the dual-slnx setup exists to dodge.
    -->
    <ItemGroup Condition="Exists('..\build\Librespot\bin\librespot.exe')">
      <None Include="..\build\Librespot\bin\librespot.exe"
            Link="librespot.exe"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>

    <ItemGroup Condition="Exists('..\build\Release\version.dll')">
      <None Include="..\build\Release\version.dll"
            Link="version.dll"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>

    <!--
      README + LICENSE travel with the publish output but never land
      in bin/Debug — keeping the dev-build folder uncluttered while
      ensuring the release zip carries the docs the user needs.
    -->
    <ItemGroup>
      <None Include="..\README.md"
            Link="README.md"
            CopyToOutputDirectory="Never"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false"
            Condition="Exists('..\README.md')" />
      <None Include="..\LICENSE"
            Link="LICENSE"
            CopyToOutputDirectory="Never"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false"
            Condition="Exists('..\LICENSE')" />
    </ItemGroup>

    <!--
      `dotnet publish` post-step that zips the publish folder into
      build/release/HorizonRadio.zip. The CI workflow uploads this as
      the release asset; running publish locally also produces the
      same zip so we can sanity-check what users will download.
      Runs after Publish, so a plain `dotnet build` doesn't trigger it.
    -->
    <Target Name="ZipPublishOutput" AfterTargets="Publish">
      <PropertyGroup>
        <!--
          ProjectDir-relative because $(SolutionDir) is *Undefined* when
          running `dotnet publish` directly on the csproj (only set
          when MSBuild is invoked via a .sln/.slnx). The repo layout
          puts build/ a single level up from HorizonRadio.UI/.
        -->
        <ReleaseStageRoot>$([System.IO.Path]::GetFullPath('$(ProjectDir)..\build\release'))</ReleaseStageRoot>
        <ReleaseZipPath>$(ReleaseStageRoot)\HorizonRadio.zip</ReleaseZipPath>
      </PropertyGroup>
      <MakeDir Directories="$(ReleaseStageRoot)" />
      <Delete Files="$(ReleaseZipPath)" Condition="Exists('$(ReleaseZipPath)')" />
      <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ReleaseZipPath)" />
      <Message Importance="high" Text="Wrote release zip: $(ReleaseZipPath)" />
    </Target>
</Project>
