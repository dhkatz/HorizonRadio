<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Multi-resolution icon for the .exe (taskbar, alt-tab,
             Explorer). Generated by tools/IconGen — re-run that
             project to refresh after a design change. -->
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

        <!--
          Publish into a single .exe so users see a handful of files in
          the release zip (UI + version.dll + docs) instead of the ~150
          DLLs that ship with a default Avalonia + self-contained publish.
          External tools (yt-dlp, ffmpeg, librespot) are not bundled —
          they install on demand from the Tools tab.

          - PublishSingleFile     bundles every managed assembly into
                                  the .exe.
          - IncludeNativeLibrariesForSelfExtract=true  ALSO bundles
                                  SkiaSharp / HarfBuzz / Avalonia
                                  native libs; they extract to a per-
                                  app temp dir on first launch and
                                  stay cached there.
          - DebugType=embedded    avoids leaving a .pdb beside the
                                  bundled exe.
          All three are publish-only — `dotnet build` ignores them so
          the dev inner loop is unchanged.
        -->
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <DebugType>embedded</DebugType>

        <!--
          Release channel stamped into the assembly so BuildInfo can read it
          at runtime for the self-updater. Workflows override it
          (-p:Channel=stable on publish, -p:Channel=nightly on the nightly
          build); a local `dotnet build`/`publish` stays 'dev'. Version
          itself comes from -p:Version= (AssemblyInformationalVersion).
        -->
        <Channel Condition="'$(Channel)' == ''">dev</Channel>
    </PropertyGroup>

    <!-- Emit [AssemblyMetadata("Channel", …)] for BuildInfo to read. -->
    <ItemGroup>
        <AssemblyMetadata Include="Channel" Value="$(Channel)" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <!--
      The tool manifest (repo root) is the single source of truth for
      pinned tool versions/URLs/hashes; embed it so the app reads it
      offline at runtime (HorizonRadio.UI.Tools.ToolManifest). See
      docs/tool-provisioning.md.
    -->
    <ItemGroup>
        <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\tools.manifest.json"
                          Link="tools.manifest.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="ShadUI" Version="0.2.3" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-570" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\HorizonRadio.Core\HorizonRadio.Core.csproj" />
      <ProjectReference Include="..\HorizonRadio.Metadata.VocaDB\HorizonRadio.Metadata.VocaDB.csproj" />
      <ProjectReference Include="..\HorizonRadio.TitleModel\HorizonRadio.TitleModel.csproj" />
    </ItemGroup>

    <!--
      Pull the C++-side version.dll into the UI's bin directory (so the
      Mods tab finds it) and into the publish output (so the release zip
      ships it). version.dll is the ONLY bundled binary: it's coupling-
      locked to the game (FMOD offsets + IPC) and can never be fetched at
      runtime. External tools (yt-dlp, ffmpeg, librespot) are NOT bundled
      — they install on demand from the Tools tab via the version-addressed
      `tools` blobstore. See docs/tool-provisioning.md.

      version.dll has separate Debug / Release build outputs; we always
      copy from Release because Debug version.dll isn't useful (FH6 doesn't
      reload a CRT-debug-DLL). CMake produces it from CMakeLists.txt at the
      repo root. Gated on Exists() so a fresh checkout that hasn't built
      the C++ side still produces a buildable UI — the user just won't get
      a bundled DLL until it's present.
    -->
    <PropertyGroup>
      <_VersionDllPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\Release\version.dll'))</_VersionDllPath>
    </PropertyGroup>

    <!--
      Build-time copy: drop version.dll into bin/{Configuration}/ so the
      dev iteration loop (run from VS / Rider / `dotnet build`) lets the
      Mods tab find it.

      ExcludeFromSingleFile keeps version.dll OUT of the single-file
      bundle. Without it the publish bundles our PROXY version.dll into
      HorizonRadio.UI.exe, the host extracts it to %TEMP%\.net\... on
      launch, and the loader pulls it into our OWN process — where its
      DllMain would start the IPC server and the UI "connects" to itself.
      The Mods tab only ever reads the loose copy from
      AppContext.BaseDirectory (placed by CopyBundledBinariesToPublish),
      never the bundle, so excluding it loses nothing. No
      CopyToPublishDirectory here — it silently no-ops for single-file.
    -->
    <ItemGroup Condition="Exists('$(_VersionDllPath)')">
      <None Include="$(_VersionDllPath)"
            Link="version.dll"
            CopyToOutputDirectory="PreserveNewest"
            ExcludeFromSingleFile="true"
            Visible="false" />
    </ItemGroup>

    <!--
      Publish-time copy: drop version.dll into PublishDir so the release
      zip ships it alongside the bundled .exe. Tools are not bundled —
      they install on demand from the Tools tab.
    -->
    <Target Name="CopyBundledBinariesToPublish" AfterTargets="Publish"
            BeforeTargets="StripPublishPdbs">
      <Copy SourceFiles="$(_VersionDllPath)"
            DestinationFolder="$(PublishDir)"
            Condition="Exists('$(_VersionDllPath)')" />
    </Target>

    <!--
      README + LICENSE travel with the publish output but never land
      in bin/Debug — keeping the dev-build folder uncluttered while
      ensuring the release zip carries the docs the user needs.
    -->
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\README.md"
            Link="README.md"
            CopyToOutputDirectory="Never"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\README.md')" />
      <None Include="$(MSBuildThisFileDirectory)..\LICENSE"
            Link="LICENSE"
            CopyToOutputDirectory="Never"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\LICENSE')" />
    </ItemGroup>

    <!--
      `dotnet publish` post-step that zips the publish folder into
      build/release/HorizonRadio.zip. The CI workflow uploads this as
      the release asset; running publish locally also produces the
      same zip so we can sanity-check what users will download.
      Runs after Publish, so a plain `dotnet build` doesn't trigger it.
    -->
    <!--
      Strip native-asset PDBs (libSkiaSharp.pdb, libHarfBuzzSharp.pdb,
      …) from the publish output before we zip. SkiaSharp.NativeAssets
      packages copy those out automatically and there's no first-class
      "don't ship them" toggle — they're not real ReferenceCopyLocal
      items so the standard PDB-suppression properties don't reach
      them. Together they add ~100 MB to the zip for zero user benefit.
      Our own managed PDB is already inlined via DebugType=embedded.
    -->
    <Target Name="StripPublishPdbs" AfterTargets="Publish" BeforeTargets="ZipPublishOutput">
      <ItemGroup>
        <_PublishPdbsToStrip Include="$(PublishDir)**\*.pdb" />
      </ItemGroup>
      <Delete Files="@(_PublishPdbsToStrip)" />
    </Target>

    <Target Name="ZipPublishOutput" AfterTargets="Publish">
      <PropertyGroup>
        <!--
          ProjectDir-relative because $(SolutionDir) is *Undefined* when
          running `dotnet publish` directly on the csproj (only set
          when MSBuild is invoked via a .sln/.slnx). The repo layout
          puts build/ a single level up from HorizonRadio.UI/.
        -->
        <ReleaseStageRoot>$([System.IO.Path]::GetFullPath('$(ProjectDir)..\build\release'))</ReleaseStageRoot>
        <ReleaseZipPath>$(ReleaseStageRoot)\HorizonRadio.zip</ReleaseZipPath>
      </PropertyGroup>
      <MakeDir Directories="$(ReleaseStageRoot)" />
      <Delete Files="$(ReleaseZipPath)" Condition="Exists('$(ReleaseZipPath)')" />
      <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ReleaseZipPath)" />
      <Message Importance="high" Text="Wrote release zip: $(ReleaseZipPath)" />
    </Target>
</Project>
