<Project Sdk="Microsoft.NET.Sdk">

  <!-- Apple/iTunes metadata plugin. References the host (Core) for shared helpers + the SDK
       (Abstractions, transitively). Mirrors HorizonRadio.Metadata.VocaDB. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- SelectMatch + the Match record are internal + unit-tested. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HorizonRadio.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HorizonRadio.Core\HorizonRadio.Core.csproj" />
  </ItemGroup>

</Project>
