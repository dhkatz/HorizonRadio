<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spotify metadata plugin. References the host (Core) for shared helpers + the SDK (Abstractions,
    transitively), SpotifyAPI.Web for the Web API client, and — when no app credentials are set — the
    Spotify SOURCE plugin to ride on its connected Web API client (SpotifyRuntime.Connection).

    That source reference is a deliberate "companion dependency": the Spotify metadata + source
    plugins are the same vendor integration split across two plugin types, so metadata depending on
    its own source is allowed (the architecture rule forbids deps between UNRELATED plugins, not this).
    No InternalsVisibleTo: nothing internal is unit-tested.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HorizonRadio.Core\HorizonRadio.Core.csproj" />
    <ProjectReference Include="..\..\Sources\HorizonRadio.Source.Spotify\HorizonRadio.Source.Spotify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SpotifyAPI.Web" Version="7.4.2" />
  </ItemGroup>

</Project>
