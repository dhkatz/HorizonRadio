<Project Sdk="Microsoft.NET.Sdk">

  <!-- Apple/iTunes metadata plugin. References only the SDK: the metadata cache and diagnostics
       come through its plugin's constructor. Mirrors HorizonRadio.Metadata.VocaDB. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- SelectMatch + the Match record are internal + unit-tested. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HorizonRadio.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HorizonRadio\HorizonRadio.Sdk\HorizonRadio.Sdk.csproj" />
  </ItemGroup>

</Project>
