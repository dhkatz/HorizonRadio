<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VocaDB metadata plugin. References only the SDK (SearchTerms, RateGate, Romaji, the metadata
    cache key); the metadata cache and diagnostics come through its plugin's constructor. The
    first metadata provider extracted into its own assembly — the pattern the others follow.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- SelectMatch/SelectArtistIds/SelectAlbumId/SelectPvs are internal + unit-tested. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HorizonRadio.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HorizonRadio\HorizonRadio.Sdk\HorizonRadio.Sdk.csproj" />
  </ItemGroup>

</Project>
