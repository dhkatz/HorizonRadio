<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.Game.ForzaHorizon6.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400"
             x:Class="HorizonRadio.Game.ForzaHorizon6.Views.MixSettingsView"
             x:DataType="vm:MixSettingsViewModel">
    <StackPanel Spacing="4">
        <TextBlock Text="Replace station" FontSize="12" FontWeight="Medium"/>
        <ComboBox ItemsSource="{Binding Options}"
                  SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"/>
        <TextBlock Text="Override which in-game station this mix replaces, or use the default station."
                   FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
