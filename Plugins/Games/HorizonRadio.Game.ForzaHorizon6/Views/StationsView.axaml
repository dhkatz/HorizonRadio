<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.Game.ForzaHorizon6.ViewModels"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="600"
             x:Class="HorizonRadio.Game.ForzaHorizon6.Views.StationsView"
             x:DataType="vm:StationsViewModel">

    <Design.DataContext>
        <vm:StationsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <ui:PageHeader Title="Stations"
                           Description="Choose what each in-game station plays. Tune to a station in Forza and Horizon Radio follows."/>

            <ui:Section Title="When You Switch Stations">
                <StackPanel Spacing="8">
                    <ComboBox ItemsSource="{Binding Modes}"
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SwitchModeOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="caption" Text="{Binding SelectedMode.Description}"/>
                    <TextBlock Classes="caption" Text="The Horizon Radio player always pauses and resumes."/>
                </StackPanel>
            </ui:Section>

            <ui:Section Title="Stations">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StationRow">
                            <ui:SettingRow Label="{Binding Name}" Description="{Binding Hint}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border IsVisible="{Binding IsOnAir}"
                                            Background="{DynamicResource ToneSuccessBrush}" CornerRadius="999"
                                            Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="On Air" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource OnToneBrush}"/>
                                    </Border>
                                    <ComboBox Width="280"
                                              ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding Selected, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StationOption">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </ui:SettingRow>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Section>

        </StackPanel>
    </ScrollViewer>
</UserControl>
