<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.Game.ForzaHorizon6.ViewModels"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="HorizonRadio.Game.ForzaHorizon6.Views.ModManagerView"
             x:DataType="vm:ModManagerViewModel">

    <Design.DataContext>
        <vm:ModManagerViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <ui:PageHeader Title="Mod Installer"
                           Description="Install or remove the Horizon Radio DLL."/>

            <ui:SectionCard Title="Game Folder">
                <StackPanel Spacing="12">

                    <StackPanel Spacing="6"
                                IsVisible="{Binding Detected.Count}">
                        <TextBlock Classes="fieldLabel" Text="Detected"/>
                        <ComboBox ItemsSource="{Binding Detected}"
                                  SelectedItem="{Binding SelectedDetected, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{DynamicResource MutedColor}"
                                                CornerRadius="4"
                                                Padding="6,1">
                                            <TextBlock Text="{Binding Source}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundColor}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Path}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="Path"/>
                        <ui:PathPicker Path="{Binding GamePath}" Placeholder="C:\Path\To\Forza Horizon 6"
                                       DialogTitle="Pick your Forza Horizon 6 install folder"/>
                    </StackPanel>
                </StackPanel>
            </ui:SectionCard>

            <Border Classes="Card" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ui:StatusAvatar Grid.Column="0" Size="44" Margin="0,0,16,0"
                                     Tone="{Binding StatusTone}" Icon="PuzzleOutline"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusDetail}"
                                   FontSize="11"
                                   Opacity="0.65"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="Outline"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasGamePath}"/>
                </Grid>
            </Border>

            <!-- Only in a development build: the app was built without the mod, or before its
                 latest build. -->
            <ui:Notice Tone="Warning" IsVisible="{Binding BundledDllMissing}"
                       Title="The mod isn't bundled"
                       Text="This build of Horizon Radio doesn't include version.dll, so there's nothing to install. Build the mod (Mods/ForzaHorizon6), then the app."/>
            <ui:Notice Tone="Warning" IsVisible="{Binding BundledDllStale}"
                       Title="A newer mod build exists"
                       Text="The mod was built after this app bundled it. Rebuild the app to bundle the new build, then install."/>

            <TextBlock Text="{Binding LastActionMessage}"
                       FontSize="11"
                       Opacity="0.8"
                       TextWrapping="Wrap"
                       IsVisible="{Binding LastActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="Secondary"
                        Content="Open Folder"
                        Command="{Binding OpenGameFolderCommand}"
                        IsVisible="{Binding HasGamePath}"/>
                <Button Classes="Destructive"
                        Content="Uninstall"
                        Command="{Binding UninstallCommand}"
                        IsEnabled="{Binding CanUninstall}"/>
                <Button Classes="Primary"
                        Content="{Binding InstallButtonLabel}"
                        Command="{Binding InstallCommand}"
                        IsEnabled="{Binding CanInstall}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
