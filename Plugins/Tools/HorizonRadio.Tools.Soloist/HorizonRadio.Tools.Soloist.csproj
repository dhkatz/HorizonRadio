<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spotify Soloist tool plugin: downloads Spotify's Windows build from Spotify's own CDN when the
       user asks (we never host or bundle it: "link users to this page instead"), and knows its
       command line, data directory and 90-day expiry. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HorizonRadio\HorizonRadio.Core\HorizonRadio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HorizonRadio.Core.Tests" />
  </ItemGroup>

</Project>
