<Project Sdk="Microsoft.NET.Sdk">

  <!-- Internet-radio source plugin (ICY stream reader + Radio Browser directory). References the
       SDK (the title model, diagnostics and process launching come through the container) and the
       ffmpeg tool plugin for its decode invocation. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HorizonRadio\HorizonRadio.Sdk\HorizonRadio.Sdk.csproj" />
    <ProjectReference Include="..\..\Tools\HorizonRadio.Tools.FFmpeg\HorizonRadio.Tools.FFmpeg.csproj" />
  </ItemGroup>

  <!-- RadioStreamTitle is internal; its title-parsing tests live in Core.Tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HorizonRadio.Core.Tests" />
  </ItemGroup>

</Project>
