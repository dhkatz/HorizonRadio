<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local-files source plugin. Builds on the plugin SDK (playlist resolution, the pausing
       pump, the title parser) decodes with NAudio and reads tags with TagLib#. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HorizonRadio\HorizonRadio.Sdk\HorizonRadio.Sdk.csproj" />
  </ItemGroup>

</Project>
