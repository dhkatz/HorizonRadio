{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Ninja Multi-Config, MSVC)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/cmake-windows-x64",
      "architecture": { "value": "x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64-analysis",
      "inherits": "windows-x64",
      "displayName": "Windows x64 + clang-tidy",
      "binaryDir": "${sourceDir}/build/cmake-windows-x64-analysis",
      "cacheVariables": { "HORIZON_RUN_CLANG_TIDY": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64", "configuration": "Debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-x64-analysis-debug", "configurePreset": "windows-x64-analysis", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
