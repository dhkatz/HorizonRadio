<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spotify source plugin: the user's account connection (PKCE Web API), the driven librespot
       playback service, the zero-config Connect receiver, search, and link parsing. References the
       SDK (the host's services come through the container; the plugin registers its connection and
       players there). Owns the SpotifyAPI.Web dependency, and NAudio for resampling what Soloist
       plays. The Spotify metadata plugin takes a companion dependency on this assembly to reuse the
       live connection. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HorizonRadio\HorizonRadio.Sdk\HorizonRadio.Sdk.csproj" />
    <ProjectReference Include="..\..\Tools\HorizonRadio.Tools.Librespot\HorizonRadio.Tools.Librespot.csproj" />
    <ProjectReference Include="..\..\Tools\HorizonRadio.Tools.Soloist\HorizonRadio.Tools.Soloist.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SpotifyAPI.Web" Version="7.4.2" />
    <!-- The login token is kept encrypted with DPAPI (SpotifyAuthStore); moves to a host secret
         service with the Platform step (docs/modular-architecture.md). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

  <!--
    Bundle the audio tap (Native/, horizon_audio_tap.dll): loaded into Spotify Soloist to take the
    audio it plays when librespot is refused a track. Always the Release build. Gated on Exists() so
    a checkout that hasn't built the C++ side still builds; Soloist playback then reports the tap
    missing. ExcludeFromSingleFile: it has to be a real file on disk for another process to load,
    and the UI's publish step copies it next to the exe (CopyBundledBinariesToPublish).
  -->
  <PropertyGroup>
    <_AudioTapDllPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)Native\build\Release\horizon_audio_tap.dll'))</_AudioTapDllPath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(_AudioTapDllPath)')">
    <None Include="$(_AudioTapDllPath)"
          Link="horizon_audio_tap.dll"
          CopyToOutputDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Visible="false" />
  </ItemGroup>

  <!-- TrackEndWatchdog is internal; its end-wait decision tests live in Core.Tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HorizonRadio.Core.Tests" />
  </ItemGroup>

</Project>
