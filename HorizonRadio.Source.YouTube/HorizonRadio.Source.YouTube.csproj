<Project Sdk="Microsoft.NET.Sdk">

  <!-- YouTube source plugin: resolves YouTube (and any yt-dlp-supported URL) into audio via yt-dlp +
       the ffmpeg PCM pump. References the host (Core) for shared playback infra + the SDK
       (Abstractions, transitively). Carries YtDlpClient for now — it relocates into Tools.YtDlp in a
       later "tools own both provisioning + invocation" step. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HorizonRadio.Core\HorizonRadio.Core.csproj" />
  </ItemGroup>

</Project>
