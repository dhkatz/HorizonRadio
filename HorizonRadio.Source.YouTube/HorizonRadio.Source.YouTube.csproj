<Project Sdk="Microsoft.NET.Sdk">

  <!-- YouTube source plugin: resolves YouTube (and any yt-dlp-supported URL) into audio via yt-dlp +
       the ffmpeg PCM pump. References the host (Core) for shared playback infra + the SDK
       (Abstractions, transitively), and the yt-dlp tool plugin for its invocation client. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HorizonRadio.Core\HorizonRadio.Core.csproj" />
    <ProjectReference Include="..\HorizonRadio.Tools.YtDlp\HorizonRadio.Tools.YtDlp.csproj" />
  </ItemGroup>

</Project>
