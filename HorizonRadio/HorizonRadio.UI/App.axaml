<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HorizonRadio.UI.App"
             xmlns:local="using:HorizonRadio.UI"
             xmlns:theme="using:HorizonRadio.Sdk.UI.Theme"
             RequestedThemeVariant="Dark">
    <!-- Dark by default; the title-bar theme switcher toggles to Light at runtime. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <!-- ShadUI, Material icons, and Horizon Radio's color tokens and text styles
             (HorizonRadio.Sdk.UI), shared with the plugins' pages. -->
        <theme:HorizonRadioTheme/>
    </Application.Styles>
</Application>
