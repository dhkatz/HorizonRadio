<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:views="using:HorizonRadio.UI.Views"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="HorizonRadio.UI.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel">

    <Design.DataContext>
        <vm:NowPlayingViewModel />
    </Design.DataContext>

    <!-- Expanded "now playing" view: the large art + metadata, and the song's lyrics under it.
         Transport, source/output pickers, and volume live in the persistent player bar
         (PlayerBarView) so they're available on every tab. Without lyrics to show (nothing
         playing) the track card sits in the middle, as it always has. -->
    <Grid Margin="24" RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Grid.RowSpan="{Binding !Lyrics.IsVisible, Converter={x:Static vm:LyricsConverters.RowSpan}}"
                Classes="Card"
                Padding="32"
                HorizontalAlignment="Stretch"
                VerticalAlignment="{Binding Lyrics.IsVisible, Converter={x:Static vm:LyricsConverters.CardAlignment}}">
            <views:TrackInfoView />
        </Border>
        <Border Grid.Row="1"
                Classes="Card"
                Margin="0,16,0,0"
                Padding="32,24"
                IsVisible="{Binding Lyrics.IsVisible}">
            <views:LyricsView DataContext="{Binding Lyrics}" />
        </Border>
    </Grid>
</UserControl>
