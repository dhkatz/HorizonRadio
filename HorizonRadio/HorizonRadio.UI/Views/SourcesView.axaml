<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:views="using:HorizonRadio.UI.Views"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="HorizonRadio.UI.Views.SourcesView"
             x:DataType="vm:SourcesViewModel">

    <Design.DataContext>
        <vm:SourcesViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">

            <ui:PageHeader Grid.Row="0" Margin="0,0,0,16" Title="Audio Source"
                           Description="Pick what plays through the in-game radio."/>

            <ui:Section Grid.Row="1" Title="Source" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <ComboBox ItemsSource="{Binding AvailableSources}"
                              SelectedItem="{Binding SelectedFactory, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="caption" Text="{Binding SelectedFactory.Description}"
                               IsVisible="{Binding SelectedFactory.Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </ui:Section>

            <ui:Section Grid.Row="2" Title="Settings" Margin="0,0,0,16">
                <StackPanel Spacing="14">
                    <views:ConfigFormView Fields="{Binding CurrentSchema}"/>
                    <TextBlock Classes="description" Text="This source has no settings."
                               IsVisible="{Binding HasNoSchema}"/>
                </StackPanel>
            </ui:Section>

            <ui:Section Grid.Row="3" Title="Account" Margin="0,0,0,16" IsVisible="{Binding IsAuthenticatingSource}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="Primary"
                                Content="Connect"
                                Command="{Binding ConnectCommand}"
                                IsVisible="{Binding !IsConnected}"/>
                        <Button Classes="Secondary"
                                Content="Reconnect"
                                Command="{Binding ConnectCommand}"
                                IsVisible="{Binding IsConnected}"/>
                        <Button Classes="Secondary"
                                Content="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                IsVisible="{Binding IsConnected}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionStatus}"
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               IsVisible="{Binding ConnectionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </ui:Section>

            <ui:Section Grid.Row="4" Title="Quick Play" Margin="0,0,0,16" IsVisible="{Binding IsContentSource}"
                        Description="Play a one-off URL, folder, or file. For a saved cross-source playlist, build a Mix in the Mixes tab.">
                <TextBox Text="{Binding QuickPlayLocator, Mode=TwoWay}"
                         PlaceholderText="{Binding QuickPlayHint}"/>
            </ui:Section>

            <TextBlock Grid.Row="6"
                       Text="{Binding StatusMessage}"
                       FontSize="11"
                       Margin="0,0,0,12"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}"/>
                    </Style>
                </TextBlock.Styles>
            </TextBlock>

            <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="Secondary"
                        Content="Stop"
                        Command="{Binding StopCommand}"
                        IsVisible="{Binding IsRunning}"/>
                <Button Classes="Primary"
                        Content="{Binding StartLabel}"
                        Command="{Binding StartCommand}"
                        IsVisible="{Binding CanStartSelected}"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
