<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="HorizonRadio.UI.Views.EventsView"
             x:DataType="vm:EventsViewModel">

    <Design.DataContext>
        <vm:EventsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <ui:PageHeader Title="Events"
                           Description="Run an action when something happens in-game."/>

            <!-- Telemetry hint -->
            <ui:Notice Tone="Info" Text="{Binding SetupHint}" IsVisible="{Binding HasSetupHint}"/>

            <!-- Events grouped by category (Racing / Menu / Radio) -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EventCategoryGroup}">
                        <StackPanel Spacing="8" Margin="0,0,0,18">
                            <TextBlock Classes="groupLabel" Text="{Binding Category}" Margin="2,0,0,0"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EventRuleRow}">
                                        <Border Classes="Card" Padding="16" Margin="0,0,0,8">
                                            <ui:SettingRow Label="{Binding DisplayName}" Description="{Binding Description}">
                                                <ComboBox MinWidth="200"
                                                          ItemsSource="{Binding Options}"
                                                          SelectedItem="{Binding SelectedOption}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:EventActionOption}">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </ui:SettingRow>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:SectionCard Title="Recent Activity">
                <StackPanel Spacing="8">
                    <TextBlock Classes="description" Text="No events yet."
                               IsVisible="{Binding !Activity.Count}"/>
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas,Cascadia Mono,monospace"
                                           FontSize="12" Opacity="0.8"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:SectionCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
