<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:views="using:HorizonRadio.UI.Views"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="HorizonRadio.UI.Views.GameSettingsView"
             x:DataType="vm:GameSettingsViewModel">

    <Design.DataContext>
        <vm:GameSettingsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <ui:PageHeader Title="Game"
                           Description="The game Horizon Radio plays into, or none to use it as a music player."/>

            <ui:Section>
                <StackPanel Spacing="12">
                    <TextBlock FontSize="13">
                        <Run Text="Current:" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <Run Text="{Binding CurrentName}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <views:GameChoiceView DataContext="{Binding Choice}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <TextBlock Text="Horizon Radio restarts to switch games."
                                   FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                   IsVisible="{Binding HasChange}"/>
                        <Button Classes="Primary" Content="Switch and Restart"
                                Command="{Binding SwitchCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Section>
        </StackPanel>
    </ScrollViewer>
</UserControl>
