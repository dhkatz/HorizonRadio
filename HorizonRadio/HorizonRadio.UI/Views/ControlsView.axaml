<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="HorizonRadio.UI.Views.ControlsView"
             x:DataType="vm:ControlsViewModel">

    <Design.DataContext>
        <vm:ControlsViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- A binding slot: a bordered cell that reads as a button. -->
        <Style Selector="Button.slot">
            <Setter Property="Height" Value="46"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Styles>

    <!-- Slot cell template: a bordered button you click to (re)bind, with a ✕
         overlay (inside the cell, so it isn't clipped) to clear. The two are
         siblings (not nested) so hit-testing is unambiguous. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:BindingSlot}">
            <Grid>
                <Button Classes="slot Outline"
                        Command="{Binding ListenCommand}"
                        IsEnabled="{Binding CanCapture}">
                    <Panel>
                        <!-- Bound with a glyph: show only the glyph -->
                        <Image Source="{Binding Glyph}" Width="30" Height="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding ShowGlyph}"/>
                        <!-- Bound without a glyph (e.g. a wheel button): show the label -->
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding ShowText}"/>
                        <!-- Empty -->
                        <TextBlock Text="Not bound"
                                   FontSize="12" Opacity="0.4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowEmpty}"/>
                        <!-- Listening -->
                        <TextBlock Text="Press input… · Esc"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryColor}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsListening}"/>
                    </Panel>
                </Button>

                <Button Classes="Ghost"
                        Command="{Binding ClearCommand}"
                        IsVisible="{Binding ShowBound}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="20" Height="20" Padding="0"
                        Margin="0,3,3,0"
                        ToolTip.Tip="Clear binding">
                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- One mapping-table row: action name + a binding slot per device column.
             Implicit so both the playback list and the profile list reuse it. -->
        <DataTemplate DataType="{x:Type vm:ControlBindingRow}">
            <Border Background="{DynamicResource CardBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,8"
                    Margin="0,0,0,6">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="158"/>
                        <ColumnDefinition Width="158"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding DisplayName}"
                               ToolTip.Tip="{Binding Description}"
                               FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    <ContentControl Grid.Column="1" Content="{Binding Keyboard}" Margin="6,0"/>
                    <ContentControl Grid.Column="2" Content="{Binding Controller}" Margin="6,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <StackPanel Spacing="4" Margin="0,0,0,4">
                <TextBlock Text="Controls" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Bind a key, mouse button, or controller / wheel input to each playback action."
                           FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <!-- Controller device picker (which controller the Controller column edits) -->
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="Controller" Width="16" Height="16"
                                            Opacity="0.6" VerticalAlignment="Center"/>
                <TextBlock Text="Controller:" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Controllers}"
                          SelectedItem="{Binding SelectedController}"
                          MinWidth="200"
                          IsVisible="{Binding HasControllers}"/>
                <TextBlock Text="None connected"
                           FontSize="12" Opacity="0.45" VerticalAlignment="Center"
                           IsVisible="{Binding !HasControllers}"/>
            </StackPanel>

            <!-- Mapping table -->
            <StackPanel Spacing="0">

                <!-- Column headers -->
                <Grid Margin="14,2,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="158"/>
                        <ColumnDefinition Width="158"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ACTION"
                               FontSize="11" FontWeight="SemiBold" Opacity="0.5"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="KEYBOARD / MOUSE"
                               FontSize="11" FontWeight="SemiBold" Opacity="0.5"
                               HorizontalAlignment="Center" Margin="6,0"/>
                    <TextBlock Grid.Column="2" Text="CONTROLLER"
                               FontSize="11" FontWeight="SemiBold" Opacity="0.5"
                               HorizontalAlignment="Center" Margin="6,0"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}"/>

                <!-- Mixes section: Next/Previous + one row per saved mix. -->
                <TextBlock Text="MIXES"
                           FontSize="11" FontWeight="SemiBold" Opacity="0.5"
                           Margin="14,10,14,6"/>
                <ItemsControl ItemsSource="{Binding MixRows}"/>
            </StackPanel>

            <!-- Recent activity -->
            <Border Classes="Card" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Recent Activity" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="No input yet."
                               FontSize="12" Opacity="0.5"
                               IsVisible="{Binding !Activity.Count}"/>
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas,Cascadia Mono,monospace"
                                           FontSize="12" Opacity="0.8"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
