<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
             x:Class="HorizonRadio.UI.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">

    <Design.DataContext>
        <vm:FriendsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <ui:PageHeader Title="Friends"
                           Description="See when your friends are online and what they're listening to; they see you too. You connect to each other directly, with no account and no server of ours."/>

            <TextBlock Classes="body" Text="{Binding Status}" IsVisible="{Binding HasStatus}"/>

            <ui:Section Title="Listening Party" IsVisible="{Binding HasParty}">
                <StackPanel Spacing="12">
                    <TextBlock Classes="body" Text="{Binding PartyTitle}"/>
                    <TextBlock Classes="description" Text="{Binding PartyDetail}" IsVisible="{Binding HasPartyDetail}"/>
                    <TextBlock Classes="description" Text="{Binding PartyProblem}" IsVisible="{Binding HasPartyProblem}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="Primary" Content="Start Party" Command="{Binding StartPartyCommand}"
                                IsVisible="{Binding CanStartParty}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Classes="Secondary" Content="End Party" Command="{Binding EndPartyCommand}"
                                IsVisible="{Binding IsHostingParty}"/>
                        <Button Classes="Secondary" Content="Leave Party" Command="{Binding LeavePartyCommand}"
                                IsVisible="{Binding IsInParty}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Section>

            <ui:Section Title="Your Friends">
                <StackPanel Spacing="12">
                    <TextBlock Classes="description" Text="None yet. Add one below." IsVisible="{Binding !HasFriends}"/>
                    <ItemsControl ItemsSource="{Binding Friends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FriendRow}">
                                <!-- Remove shows under the pointer (or with keyboard focus), so the
                                     list isn't a column of Remove buttons. -->
                                <Border Classes="listRow" Margin="-8,0">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <material:MaterialIcon Grid.Column="0" Kind="Account" Width="20" Height="20"
                                                           Margin="0,0,12,0" VerticalAlignment="Center"
                                                           Opacity="{Binding IconOpacity}"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock Classes="caption" Text="{Binding State}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="Primary" Content="Join Party" Margin="0,0,8,0"
                                            Command="{Binding JoinCommand}" IsVisible="{Binding CanJoin}"/>
                                    <Button Grid.Column="3" Classes="Ghost rowActions" Content="Remove"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="{Binding Name, StringFormat='Remove {0} From Your Friends'}"/>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Section>

            <ui:Section Title="Add a Friend"
                            Description="One of you shows a code; the other types it on their Friends page. You're then friends on all your PCs.">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="6" IsVisible="{Binding IsShowingCode}">
                        <SelectableTextBlock Classes="mono" Text="{Binding InviteCode}" FontSize="28" FontWeight="SemiBold"
                                             LetterSpacing="2"/>
                        <TextBlock Classes="caption" Text="{Binding InviteExpires}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="Primary" Content="Show Code" Command="{Binding ShowCodeCommand}"
                                IsVisible="{Binding !IsShowingCode}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Classes="Secondary" Content="New Code" Command="{Binding ShowCodeCommand}"
                                IsVisible="{Binding IsShowingCode}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Classes="Secondary" Content="Hide Code" Command="{Binding HideCodeCommand}"
                                IsVisible="{Binding IsShowingCode}"/>
                    </StackPanel>
                    <Separator Margin="0,4"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding FriendCode, Mode=TwoWay}" PlaceholderText="Your friend's code"
                                 FontFamily="Consolas,Cascadia Mono,monospace" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Classes="Primary" Content="Add Friend" Command="{Binding AddCommand}"
                                IsEnabled="{Binding !IsBusy}"/>
                    </Grid>
                </StackPanel>
            </ui:Section>

            <ui:Section Title="You"
                            Description="What your friends see you as. Your friends see the song you're playing while Horizon Radio is open.">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding MyName, Mode=TwoWay}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Classes="Secondary" Content="Rename" Command="{Binding RenameCommand}"/>
                </Grid>
            </ui:Section>
        </StackPanel>
    </ScrollViewer>
</UserControl>
