<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:views="using:HorizonRadio.UI.Views"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="HorizonRadio.UI.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <Design.DataContext>
        <vm:HistoryViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <ui:PageHeader Title="History" Description="Songs you've played.">
                <ui:PageHeader.Actions>
                    <Button Classes="Outline" Content="Clear History"
                            Command="{Binding ClearCommand}"
                            IsVisible="{Binding !IsEmpty}"/>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <ui:EmptyState Icon="History" Title="Nothing played yet" Text="Songs you play will show up here."
                           IsVisible="{Binding IsEmpty}"/>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                        <ui:SongRow Art="{Binding Thumbnail}" Title="{Binding Title}" Subtitle="{Binding Subtitle}"
                                    PlayCommand="{Binding PlayCommand}"
                                    views:SongMenu.Target="{Binding Song}">
                            <ui:SongRow.TitleAdornment>
                                <!-- The warning doubles as the report button. -->
                                <Button Classes="Ghost" Padding="2" Margin="0,0,6,0"
                                        Command="{Binding ReportCommand}"
                                        IsVisible="{Binding ShowWarning}"
                                        ToolTip.Tip="We couldn't identify this song. Click to report a metadata issue.">
                                    <material:MaterialIcon Kind="AlertCircleOutline" Width="15" Height="15"
                                                           Foreground="{DynamicResource ToneWarningBrush}"/>
                                </Button>
                            </ui:SongRow.TitleAdornment>
                            <ui:SongRow.Detail>
                                <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.45">
                                    <TextBlock Text="{Binding SourceLabel}" FontSize="10"/>
                                    <TextBlock Text="·" FontSize="10"/>
                                    <TextBlock Text="{Binding PlayedAtLabel}" FontSize="10"/>
                                </StackPanel>
                            </ui:SongRow.Detail>
                            <ui:SongRow.Actions>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- One playable service: a single Play button. -->
                                    <Button Classes="Primary" Content="Play" Command="{Binding PlayCommand}"
                                            IsVisible="{Binding !HasMultipleSources}"/>
                                    <!-- Several services: a Play button per service, inline (no popup that
                                         could steal the row's hover and hide the other actions). -->
                                    <ItemsControl ItemsSource="{Binding PlaySources}"
                                                  IsVisible="{Binding HasMultipleSources}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ReplaySourceOption}">
                                                <Button Classes="Outline" Command="{Binding PlayCommand}"
                                                        ToolTip.Tip="{Binding Label, StringFormat='Play From {0}'}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <material:MaterialIcon Kind="Play" Width="14" Height="14"/>
                                                        <TextBlock Text="{Binding Label}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Classes="Ghost" Padding="6" Command="{Binding Song.AddToQueueCommand}"
                                            IsVisible="{Binding Song, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            ToolTip.Tip="Add To Queue">
                                        <material:MaterialIcon Kind="PlaylistPlay" Width="16" Height="16"/>
                                    </Button>
                                    <Button Classes="Ghost" Padding="6" views:SongMenu.MixPicker="{Binding Song}"
                                            IsVisible="{Binding Song, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            ToolTip.Tip="Add To Mix">
                                        <material:MaterialIcon Kind="PlaylistPlus" Width="16" Height="16"/>
                                    </Button>
                                    <Button Classes="Ghost" Padding="6" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="Remove From History">
                                        <material:MaterialIcon Kind="Close" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </ui:SongRow.Actions>
                        </ui:SongRow>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
