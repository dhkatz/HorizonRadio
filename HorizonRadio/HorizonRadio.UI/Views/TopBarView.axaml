<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:views="using:HorizonRadio.UI.Views"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="52"
             x:Class="HorizonRadio.UI.Views.TopBarView"
             x:DataType="vm:TopBarViewModel">

    <Design.DataContext>
        <vm:TopBarViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.searchPill:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Just the search pill + live-results dropdown; this control is injected into the
         ShadUI title bar's centre slot (see MainWindow.OnApplyTemplate), so it carries no
         bar chrome of its own — the title bar is the bar. -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid VerticalAlignment="Center">
                <Border x:Name="SearchPill"
                        Width="360" Height="32"
                        CornerRadius="16"
                        Background="{DynamicResource SecondaryColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Classes="searchPill"
                        Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <material:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                               Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Search for tracks…"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="13"
                                 KeyDown="OnSearchKeyDown"
                                 GotFocus="OnSearchGotFocus"/>
                        <Button Grid.Column="2" Classes="Ghost" Padding="4"
                                IsVisible="{Binding Query, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Command="{Binding ClearCommand}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Clear">
                            <material:MaterialIcon Kind="Close" Width="14" Height="14" Opacity="0.6"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Live results, anchored under the pill. Light-dismiss closes it
                     (writes IsDropdownOpen back via the two-way bind). -->
                <Popup PlacementTarget="{Binding #SearchPill}"
                       Placement="Bottom"
                       HorizontalOffset="0" VerticalOffset="6"
                       IsLightDismissEnabled="True"
                       IsOpen="{Binding IsDropdownOpen, Mode=TwoWay}">
                    <Border Width="420" MaxHeight="380"
                            Background="{DynamicResource CardBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6">
                        <Panel>
                            <!-- Searching / empty states -->
                            <TextBlock Text="Searching…" FontSize="12" Opacity="0.55" Margin="10,8"
                                       IsVisible="{Binding IsSearching}"/>
                            <TextBlock Text="No results found." FontSize="12" Opacity="0.55" Margin="10,8"
                                       IsVisible="{Binding HasNoResults}"/>
                            <TextBlock Text="Connect a music source in Sources to search." FontSize="12"
                                       Opacity="0.55" Margin="10,8" TextWrapping="Wrap"
                                       IsVisible="{Binding NeedsConnection}"/>

                            <ScrollViewer IsVisible="{Binding !IsSearching}">
                            <ItemsControl ItemsSource="{Binding LiveResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SearchResultRowViewModel}">
                                        <!-- A quick-action peek: Play and Add stay visible. -->
                                        <ui:SongRow ArtSize="40" Art="{Binding Art}" Title="{Binding Title}"
                                                    Subtitle="{Binding Subtitle}" PlayCommand="{Binding PlayCommand}"
                                                    views:SongMenu.Target="{Binding Song}">
                                            <ui:SongRow.Trailing>
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <!-- Which source plays; only when >1 source is searchable -->
                                                    <Border IsVisible="{Binding ShowSourceLabels}"
                                                            Background="{DynamicResource SecondaryColor}"
                                                            CornerRadius="10" Padding="8,2" Margin="0,0,4,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedSourceName}" FontSize="10" Opacity="0.75"/>
                                                    </Border>
                                                    <Button Classes="Ghost" Padding="5"
                                                            Command="{Binding PlayCommand}" ToolTip.Tip="Play Now">
                                                        <material:MaterialIcon Kind="Play" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Classes="Ghost" Padding="5"
                                                            Command="{Binding AddCommand}" ToolTip.Tip="Add To Queue">
                                                        <material:MaterialIcon Kind="PlaylistPlay" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </ui:SongRow.Trailing>
                                        </ui:SongRow>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </Popup>
        </Grid>
    </Grid>
</UserControl>
