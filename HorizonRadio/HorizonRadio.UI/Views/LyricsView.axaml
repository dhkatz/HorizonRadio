<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="360"
             x:Class="HorizonRadio.UI.Views.LyricsView"
             x:Name="Root"
             x:DataType="vm:LyricsViewModel">

    <!-- The playing song's lyrics. Synced lyrics follow the song: the line being sung is bright
         and kept in the middle; clicking a line jumps there when the source can seek. Unsynced
         lyrics (and live radio, which doesn't know where in the song it is yet) are a sheet. -->
    <Grid RowDefinitions="*,Auto">
        <TextBlock Grid.Row="0"
                   Text="{Binding Status}"
                   FontSize="14" Opacity="0.55"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <ScrollViewer Grid.Row="0"
                      x:Name="Scroller"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HasLines}">
            <!-- Lines fade out at the top and bottom edges rather than being cut off; the list's
                 margin keeps the first and last lines clear of the fade. -->
            <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.12" Color="Black" />
                    <GradientStop Offset="0.88" Color="Black" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
            <ItemsControl x:Name="LinesList" ItemsSource="{Binding Lines}" Margin="0,40">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LyricLineViewModel">
                        <Border Background="Transparent"
                                Padding="0,5"
                                Cursor="{Binding #Root.((vm:LyricsViewModel)DataContext).CanSeek, Converter={x:Static vm:LyricsConverters.HandCursor}}"
                                Tapped="OnLineTapped">
                            <TextBlock Text="{Binding Text}"
                                       FontSize="{Binding IsBackground, Converter={x:Static vm:LyricsConverters.LineSize}}"
                                       FontWeight="SemiBold"
                                       FontStyle="{Binding IsBackground, Converter={x:Static vm:LyricsConverters.LineStyle}}"
                                       Opacity="{Binding Opacity}"
                                       TextWrapping="Wrap">
                                <TextBlock.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                                    </Transitions>
                                </TextBlock.Transitions>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Text="{Binding Credit}"
                   FontSize="11" Opacity="0.45"
                   Margin="0,12,0,0"
                   IsVisible="{Binding Credit, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Grid>
</UserControl>
