<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HorizonRadio.UI.Views"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="HorizonRadio.UI.Views.MetadataView"
             x:DataType="vm:MetadataViewModel">

    <Design.DataContext>
        <vm:MetadataViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <ui:PageHeader Title="Metadata"
                           Description="Where to look up canonical titles, artists, and album art. Providers run after the source in the order below; each fills only what's still missing, unless you pin a field to one provider below."/>

            <!-- Providers: enable + order + credentials -->
            <ui:Section Title="Providers" Description="Asked in this order.">
                <ItemsControl Classes="divided" ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MetadataProviderRow}">
                            <Border Padding="0,10">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.55"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                                    VerticalAlignment="Center">
                                            <Button Classes="Ghost" Padding="6" Command="{Binding MoveUpCommand}"
                                                    ToolTip.Tip="Higher priority">
                                                <materialIcons:MaterialIcon Kind="ChevronUp" Width="16" Height="16"/>
                                            </Button>
                                            <Button Classes="Ghost" Padding="6" Command="{Binding MoveDownCommand}"
                                                    ToolTip.Tip="Lower priority">
                                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <views:ConfigFormView Fields="{Binding Fields}" IsVisible="{Binding HasFields}"
                                                          Margin="34,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Section>

            <!-- Per-field overrides -->
            <ui:Section Title="Field Sources"
                        Description="Pin a field to one provider, or leave it on Auto to use the order above.">
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MetadataFieldRow}">
                            <ui:SettingRow Label="{Binding Label}">
                                <ComboBox ItemsSource="{Binding Options}"
                                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                                          MinWidth="240">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:OverrideOption}">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </ui:SettingRow>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Section>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="Primary" Content="Apply" Command="{Binding ApplyCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
