<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:views="using:HorizonRadio.UI.Views"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="HorizonRadio.UI.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <Design.DataContext>
        <vm:SearchViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True" Margin="24,16">

        <!-- Header -->
        <ui:PageHeader DockPanel.Dock="Top" Margin="0,0,0,16" Title="Search Results"
                       Description="{Binding Query, StringFormat='Results for “{0}”'}"/>

        <!-- Source filter chips (only when more than one source is searchable) -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Filters}"
                      IsVisible="{Binding ShowFilters}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SourceFilterChipViewModel}">
                    <Button Command="{Binding ToggleCommand}" Classes="Outline"
                            Padding="10,4" CornerRadius="14"
                            Opacity="{Binding IsEnabled, Converter={x:Static vm:SearchConverters.EnabledOpacity}}"
                            ToolTip.Tip="Toggle Source">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Check" Width="13" Height="13"
                                                   IsVisible="{Binding IsEnabled}"/>
                            <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Per-source problem notices (failed / not connected), beside any results -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SourceNotices}"
                      IsVisible="{Binding HasSourceNotices}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <ui:Notice Classes="inline" Tone="Warning" Text="{Binding}" Margin="0,0,0,4"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Searching / empty states -->
        <TextBlock DockPanel.Dock="Top" Text="Searching…" FontSize="13" Opacity="0.55"
                   IsVisible="{Binding IsSearching}"/>
        <TextBlock DockPanel.Dock="Top" Text="No results found. Try a different search."
                   FontSize="13" Opacity="0.55"
                   IsVisible="{Binding HasNoResults}"/>
        <ui:Notice DockPanel.Dock="Top" Classes="inline" Tone="Danger"
                   Text="Search failed. Check your connection and try again."
                   IsVisible="{Binding HasError}"/>
        <TextBlock DockPanel.Dock="Top" Text="Connect a music source (e.g. Spotify) in Sources to search."
                   FontSize="13" Opacity="0.55"
                   IsVisible="{Binding NeedsConnection}"/>
        <TextBlock DockPanel.Dock="Top" Text="No sources selected. Enable a source filter above to see results."
                   FontSize="13" Opacity="0.55"
                   IsVisible="{Binding NoSourcesSelected}"/>

        <ScrollViewer IsVisible="{Binding HasResults}">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SearchResultRowViewModel}">
                        <ui:SongRow Art="{Binding Art}" Title="{Binding Title}" Subtitle="{Binding Subtitle}"
                                    PlayCommand="{Binding PlayCommand}"
                                    views:SongMenu.Target="{Binding Song}">
                            <!-- Source area: a picker when the track came from >1 source, else a single
                                 static label. Only shown once >1 source is searchable. -->
                            <ui:SongRow.Trailing>
                                <Panel IsVisible="{Binding ShowSourceLabels}">
                                    <ComboBox ItemsSource="{Binding Sources}"
                                              SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                              IsVisible="{Binding HasMultipleSources}"
                                              FontSize="12" MinWidth="118"
                                              ToolTip.Tip="Choose Which Source Plays">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SourceOption}">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Border IsVisible="{Binding !HasMultipleSources}"
                                            Background="{DynamicResource SecondaryColor}"
                                            CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedSourceName}" FontSize="11" Opacity="0.75"/>
                                    </Border>
                                </Panel>
                            </ui:SongRow.Trailing>
                            <ui:SongRow.Actions>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="Ghost" Padding="6" Command="{Binding PlayCommand}"
                                            ToolTip.Tip="Play Now">
                                        <material:MaterialIcon Kind="Play" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="Ghost" Padding="6" Command="{Binding AddCommand}"
                                            ToolTip.Tip="Add To Queue">
                                        <material:MaterialIcon Kind="PlaylistPlay" Width="18" Height="18"/>
                                    </Button>
                                    <Button Classes="Ghost" Padding="6" views:SongMenu.MixPicker="{Binding Song}"
                                            IsVisible="{Binding Song, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            ToolTip.Tip="Add To Mix">
                                        <material:MaterialIcon Kind="PlaylistPlus" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </ui:SongRow.Actions>
                        </ui:SongRow>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
