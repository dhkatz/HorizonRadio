<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
             x:Class="HorizonRadio.UI.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">

    <Design.DataContext>
        <vm:DevicesViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <ui:PageHeader Title="Devices"
                           Description="Pair your PCs to keep your settings in step between them. They connect to each other directly, with no account and no server of ours: your settings only go to your own devices."/>

            <TextBlock Classes="body" Text="{Binding Status}" IsVisible="{Binding HasStatus}"/>

            <ui:SectionCard Title="Your Devices">
                <StackPanel Spacing="12">
                    <TextBlock Classes="description" Text="Only this one so far. Add another below."
                               IsVisible="{Binding !IsPaired}"/>
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceRow}">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                    <material:MaterialIcon Grid.Column="0" Kind="Monitor" Width="20" Height="20"
                                                           Margin="0,0,12,0" VerticalAlignment="Center"
                                                           Opacity="{Binding IconOpacity}"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock Classes="caption" Text="{Binding State}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="Secondary" Content="Remove"
                                            Command="{Binding RemoveCommand}"
                                            IsVisible="{Binding CanRemove}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:SectionCard>

            <ui:SectionCard Title="Add a Device"
                            Description="Show a code here, then type it on the other PC's Devices page.">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="6" IsVisible="{Binding IsShowingCode}">
                        <SelectableTextBlock Classes="mono" Text="{Binding PairingCode}" FontSize="28" FontWeight="SemiBold"
                                             LetterSpacing="2"/>
                        <TextBlock Classes="caption" Text="{Binding PairingExpires}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="Primary" Content="Show Code" Command="{Binding ShowCodeCommand}"
                                IsVisible="{Binding !IsShowingCode}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Classes="Secondary" Content="New Code" Command="{Binding ShowCodeCommand}"
                                IsVisible="{Binding IsShowingCode}" IsEnabled="{Binding !IsBusy}"/>
                        <Button Classes="Secondary" Content="Hide Code" Command="{Binding HideCodeCommand}"
                                IsVisible="{Binding IsShowingCode}"/>
                    </StackPanel>
                </StackPanel>
            </ui:SectionCard>

            <ui:SectionCard Title="Join Your Other Devices" IsVisible="{Binding CanJoin}"
                            Description="On a PC that's already set up, open Devices and choose Show Code. Type the code here; this PC then takes its synced settings where they're newer.">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding JoinCode, Mode=TwoWay}" PlaceholderText="ABCD-EFGH-JKLM"
                             FontFamily="Consolas,Cascadia Mono,monospace" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Classes="Primary" Content="Join" Command="{Binding JoinCommand}"
                            IsEnabled="{Binding !IsBusy}"/>
                </Grid>
            </ui:SectionCard>

            <ui:SectionCard Title="This Device">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding ThisDeviceName, Mode=TwoWay}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Classes="Secondary" Content="Rename" Command="{Binding RenameCommand}"/>
                    </Grid>
                    <TextBlock Classes="caption"
                               Text="What syncs: lyrics, shuffle, the search order, the metadata providers' order, event rules and controls. What stays on each PC: folders, audio devices, the game, logins and keys."/>
                    <Button Classes="Secondary" Content="Leave My Devices" Command="{Binding LeaveCommand}"
                            IsVisible="{Binding IsPaired}" HorizontalAlignment="Left"/>
                </StackPanel>
            </ui:SectionCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
