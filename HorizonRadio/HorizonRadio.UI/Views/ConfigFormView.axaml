<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600"
             x:Class="HorizonRadio.UI.Views.ConfigFormView"
             x:Name="Root">

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:DirectoryFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <ui:PathPicker Path="{Binding Path}" Placeholder="Pick a folder…"
                               DialogTitle="{Binding Label, StringFormat='Pick a folder: {0}'}"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FileFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <ui:PathPicker Path="{Binding Path}" Kind="File" Placeholder="Pick a file…"
                               FileExtensions="{Binding FileField.ExtensionFilter}"
                               DialogTitle="{Binding Label, StringFormat='Pick a file: {0}'}"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToolFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>

                <ComboBox ItemsSource="{Binding Available}"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="ToolPick_SelectionChanged"
                          Tag="{Binding}"
                          IsVisible="{Binding HasAvailable}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{DynamicResource MutedColor}"
                                        CornerRadius="4"
                                        Padding="6,1">
                                    <TextBlock Text="Installed"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundColor}"/>
                                </Border>
                                <TextBlock Text="{Binding Path}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ui:PathPicker Path="{Binding Path}" Kind="File" Placeholder="Or paste a custom path…"
                               FileExtensions="{Binding Extensions}"
                               DialogTitle="{Binding Label, StringFormat='Pick a file: {0}'}"/>

                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Text="Not installed. Open the Tools tab to download."
                           FontSize="11" Opacity="0.55"
                           IsVisible="{Binding !HasAvailable}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <TextBox Text="{Binding Text, Mode=TwoWay}"
                         PasswordChar="{Binding PasswordChar}"
                         PlaceholderText="{Binding Placeholder}"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BoolFieldViewModel}">
            <ui:SettingRow Label="{Binding Label}" Description="{Binding Description}">
                <ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}"/>
            </ui:SettingRow>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EnumFieldViewModel}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"/>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ItemsControl ItemsSource="{Binding #Root.Fields}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="14"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
