<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HorizonRadio.Sdk.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HorizonRadio.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="HorizonRadio.UI.Views.ToolsView"
             x:DataType="vm:ToolsViewModel">

    <Design.DataContext>
        <vm:ToolsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <ui:PageHeader Title="Tools" Description="Install the external binaries some sources depend on.">
                <ui:PageHeader.Actions>
                    <Button Classes="Ghost"
                            Content="{Binding CheckLabel}"
                            Command="{Binding CheckCommand}"
                            IsEnabled="{Binding !IsChecking}"/>
                </ui:PageHeader.Actions>
            </ui:PageHeader>

            <!-- One row per tool: status, name and what it's for, then its actions. -->
            <ItemsControl Classes="divided" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolItemViewModel}">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10">
                            <ui:StatusAvatar Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Top"
                                             Tone="{Binding StatusTone}" Icon="Toolbox"/>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="sectionTitle" Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Classes="caption" Text="{Binding StatusLabel}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Classes="description" Text="{Binding Description}"/>

                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding HasSha}"
                                            ToolTip.Tip="{Binding ShaFull}">
                                    <materialIcons:MaterialIcon Kind="ShieldCheck" Width="14" Height="14"
                                                                Foreground="{DynamicResource ToneSuccessBrush}"
                                                                VerticalAlignment="Center"/>
                                    <TextBlock Classes="caption" Text="Verified" VerticalAlignment="Center"/>
                                    <TextBlock Classes="caption mono" Text="{Binding ShaShort}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Spacing="4" Margin="0,4,0,0" MaxWidth="420" HorizontalAlignment="Left"
                                            IsVisible="{Binding IsWorking}">
                                    <ProgressBar Minimum="0" Maximum="1" MinWidth="320"
                                                 Value="{Binding ProgressFraction}"
                                                 IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                                 Height="6"/>
                                    <TextBlock Classes="caption" Text="{Binding ProgressText}"/>
                                </StackPanel>

                                <TextBlock Classes="body" Text="{Binding ErrorMessage}"
                                           Foreground="{DynamicResource ToneDangerBrush}"
                                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Classes="Ghost"
                                        Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        IsVisible="{Binding IsWorking}"/>
                                <Button Classes="Ghost"
                                        Content="Uninstall"
                                        Command="{Binding UninstallCommand}"
                                        IsEnabled="{Binding CanUninstall}"
                                        IsVisible="{Binding IsInstalled}"/>
                                <Button Classes="Primary"
                                        Content="{Binding InstallButtonLabel}"
                                        Command="{Binding InstallCommand}"
                                        IsEnabled="{Binding CanInstall}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
