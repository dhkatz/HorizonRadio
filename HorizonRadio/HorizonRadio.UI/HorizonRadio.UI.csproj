<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Multi-resolution icon for the .exe (taskbar, alt-tab,
             Explorer). Generated by tools/IconGen — re-run that
             project to refresh after a design change. -->
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

        <!--
          Publish into a single .exe so users see a handful of files in
          the release zip (UI + version.dll + docs) instead of the ~150
          DLLs that ship with a default Avalonia + self-contained publish.
          External tools (yt-dlp, ffmpeg, librespot) are not bundled —
          they install on demand from the Tools tab.

          - PublishSingleFile     bundles every managed assembly into
                                  the .exe.
          - IncludeNativeLibrariesForSelfExtract=true  ALSO bundles
                                  SkiaSharp / HarfBuzz / Avalonia
                                  native libs; they extract to a per-
                                  app temp dir on first launch and
                                  stay cached there.
          - DebugType=embedded    avoids leaving a .pdb beside the
                                  bundled exe.
          All three are publish-only — `dotnet build` ignores them so
          the dev inner loop is unchanged.
        -->
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <DebugType>embedded</DebugType>

        <!--
          Release channel stamped into the assembly so BuildInfo can read it
          at runtime for the self-updater. Workflows override it
          (-p:Channel=stable on publish, -p:Channel=nightly on the nightly
          build); a local `dotnet build`/`publish` stays 'dev'. Version
          itself comes from -p:Version= (AssemblyInformationalVersion).
        -->
        <Channel Condition="'$(Channel)' == ''">dev</Channel>
    </PropertyGroup>

    <!-- Emit [AssemblyMetadata("Channel", …)] for BuildInfo to read. -->
    <ItemGroup>
        <AssemblyMetadata Include="Channel" Value="$(Channel)" />
    </ItemGroup>

    <!--
      Emit one [AssemblyMetadata("PluginAssembly_X", "X")] per referenced HorizonRadio assembly so
      PluginDiscovery can load + scan them at runtime. Generated from the actual project references
      (no hand-maintained list), and is the single-file-safe way to enumerate the bundled plugin
      assemblies: DependencyContext.Default is null in a single-file app, and there's no API to list
      bundle contents, but Assembly.Load by name resolves from the bundle. The distinct key per
      assembly avoids MSBuild collapsing same-Include items; the %(…) batching only expands inside a
      target, hence this isn't a plain ItemGroup. (Phase 2's external plugins load by path from a
      plugins dir, a separate path that doesn't need this.) -->
    <Target Name="EmitPluginAssemblyMetadata" BeforeTargets="GetAssemblyAttributes">
        <ItemGroup>
            <AssemblyMetadata Include="PluginAssembly_%(ProjectReference.Filename)"
                              Value="%(ProjectReference.Filename)" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-570" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\HorizonRadio.Core\HorizonRadio.Core.csproj" />
      <ProjectReference Include="..\HorizonRadio.Sdk.UI\HorizonRadio.Sdk.UI.csproj" />
      <ProjectReference Include="..\..\Plugins\Lyrics\HorizonRadio.Lyrics.Lrclib\HorizonRadio.Lyrics.Lrclib.csproj" />
      <ProjectReference Include="..\..\Plugins\Lyrics\HorizonRadio.Lyrics.Unison\HorizonRadio.Lyrics.Unison.csproj" />
      <ProjectReference Include="..\..\Plugins\Metadata\HorizonRadio.Metadata.Apple\HorizonRadio.Metadata.Apple.csproj" />
      <ProjectReference Include="..\..\Plugins\Metadata\HorizonRadio.Metadata.MusicBrainz\HorizonRadio.Metadata.MusicBrainz.csproj" />
      <ProjectReference Include="..\..\Plugins\Metadata\HorizonRadio.Metadata.Spotify\HorizonRadio.Metadata.Spotify.csproj" />
      <ProjectReference Include="..\..\Plugins\Metadata\HorizonRadio.Metadata.VocaDB\HorizonRadio.Metadata.VocaDB.csproj" />
      <ProjectReference Include="..\..\Plugins\Sources\HorizonRadio.Source.Local\HorizonRadio.Source.Local.csproj" />
      <ProjectReference Include="..\..\Plugins\Sources\HorizonRadio.Source.Radio\HorizonRadio.Source.Radio.csproj" />
      <ProjectReference Include="..\..\Plugins\Sources\HorizonRadio.Source.Spotify\HorizonRadio.Source.Spotify.csproj" />
      <ProjectReference Include="..\..\Plugins\Sources\HorizonRadio.Source.Test\HorizonRadio.Source.Test.csproj" />
      <ProjectReference Include="..\..\Plugins\Sources\HorizonRadio.Source.YouTube\HorizonRadio.Source.YouTube.csproj" />
      <ProjectReference Include="..\..\Plugins\Tools\HorizonRadio.Tools.YtDlp\HorizonRadio.Tools.YtDlp.csproj" />
      <ProjectReference Include="..\..\Plugins\Games\HorizonRadio.Game.ForzaHorizon6\HorizonRadio.Game.ForzaHorizon6.csproj" />
      <ProjectReference Include="..\..\Plugins\Tools\HorizonRadio.Tools.FFmpeg\HorizonRadio.Tools.FFmpeg.csproj" />
      <ProjectReference Include="..\..\Plugins\Tools\HorizonRadio.Tools.Librespot\HorizonRadio.Tools.Librespot.csproj" />
      <ProjectReference Include="..\..\Plugins\Tools\HorizonRadio.Tools.Peer\HorizonRadio.Tools.Peer.csproj" />
      <ProjectReference Include="..\..\Plugins\Tools\HorizonRadio.Tools.Soloist\HorizonRadio.Tools.Soloist.csproj" />
      <ProjectReference Include="..\..\Plugins\Tools\HorizonRadio.Tools.TitleModel\HorizonRadio.Tools.TitleModel.csproj" />
      <ProjectReference Include="..\HorizonRadio.TitleModel\HorizonRadio.TitleModel.csproj" />
    </ItemGroup>

    <!--
      Publish-time copy of the bundled game mod(s). A game plugin bundles its mod by flowing it
      into this app's build output (the FH6 plugin's version.dll; see
      HorizonRadio.Game.ForzaHorizon6.csproj), marked ExcludeFromSingleFile so it never lands
      inside the single-file exe. Copy it from the build output into PublishDir so the release
      zip ships it next to the exe, where the Mods page installs it from. The Spotify plugin's audio
      tap (horizon_audio_tap.dll, loaded into Spotify Soloist) travels the same way. Tools are not bundled —
      they install on demand from the Tools tab (Plugins/Tools/tool-provisioning.md).
    -->
    <Target Name="CopyBundledBinariesToPublish" AfterTargets="Publish"
            BeforeTargets="StripPublishPdbs">
      <Copy SourceFiles="$(OutDir)version.dll"
            DestinationFolder="$(PublishDir)"
            Condition="Exists('$(OutDir)version.dll')" />
      <Copy SourceFiles="$(OutDir)horizon_audio_tap.dll"
            DestinationFolder="$(PublishDir)"
            Condition="Exists('$(OutDir)horizon_audio_tap.dll')" />
      <Copy SourceFiles="$(OutDir)horizon-peer.exe"
            DestinationFolder="$(PublishDir)"
            Condition="Exists('$(OutDir)horizon-peer.exe')" />
    </Target>

    <!--
      README + LICENSE travel with the publish output but never land
      in bin/Debug — keeping the dev-build folder uncluttered while
      ensuring the release zip carries the docs the user needs.
    -->
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\..\README.md"
            Link="README.md"
            CopyToOutputDirectory="Never"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\..\README.md')" />
      <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE"
            Link="LICENSE"
            CopyToOutputDirectory="Never"
            CopyToPublishDirectory="PreserveNewest"
            Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\..\LICENSE')" />
    </ItemGroup>

    <!--
      `dotnet publish` post-step that zips the publish folder into
      build/release/HorizonRadio.zip. The CI workflow uploads this as
      the release asset; running publish locally also produces the
      same zip so we can sanity-check what users will download.
      Runs after Publish, so a plain `dotnet build` doesn't trigger it.
    -->
    <!--
      Strip native-asset PDBs (libSkiaSharp.pdb, libHarfBuzzSharp.pdb,
      …) from the publish output before we zip. SkiaSharp.NativeAssets
      packages copy those out automatically and there's no first-class
      "don't ship them" toggle — they're not real ReferenceCopyLocal
      items so the standard PDB-suppression properties don't reach
      them. Together they add ~100 MB to the zip for zero user benefit.
      Our own managed PDB is already inlined via DebugType=embedded.
    -->
    <Target Name="StripPublishPdbs" AfterTargets="Publish" BeforeTargets="ZipPublishOutput">
      <ItemGroup>
        <_PublishPdbsToStrip Include="$(PublishDir)**\*.pdb" />
      </ItemGroup>
      <Delete Files="@(_PublishPdbsToStrip)" />
    </Target>

    <Target Name="ZipPublishOutput" AfterTargets="Publish">
      <PropertyGroup>
        <!--
          ProjectDir-relative because $(SolutionDir) is *Undefined* when
          running `dotnet publish` directly on the csproj (only set
          when MSBuild is invoked via a .sln/.slnx). The repo layout
          puts build/ two levels up from HorizonRadio/HorizonRadio.UI/ (the repo root).
        -->
        <ReleaseStageRoot>$([System.IO.Path]::GetFullPath('$(ProjectDir)..\..\build\release'))</ReleaseStageRoot>
        <ReleaseZipPath>$(ReleaseStageRoot)\HorizonRadio.zip</ReleaseZipPath>
      </PropertyGroup>
      <MakeDir Directories="$(ReleaseStageRoot)" />
      <Delete Files="$(ReleaseZipPath)" Condition="Exists('$(ReleaseZipPath)')" />
      <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ReleaseZipPath)" />
      <Message Importance="high" Text="Wrote release zip: $(ReleaseZipPath)" />
    </Target>
</Project>
