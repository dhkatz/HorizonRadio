<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:HorizonRadio.Sdk.UI.Controls">

    <!-- <ui:PageHeader Title="History" Description="Songs you've played.">
             <ui:PageHeader.Actions><Button …/></ui:PageHeader.Actions>
         </ui:PageHeader> -->
    <ControlTheme x:Key="{x:Type ui:PageHeader}" TargetType="ui:PageHeader">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="pageTitle" Text="{TemplateBinding Title}"/>
                        <TextBlock Classes="description" Text="{TemplateBinding Description}"
                                   IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Actions}"
                                      VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- <ui:Section Title="Your Friends" Description="…"> content </ui:Section>
         No surface of its own: a hairline above it and space around it set it apart, so sections
         read as parts of one page rather than boxes on it. -->
    <ControlTheme x:Key="{x:Type ui:Section}" TargetType="ui:Section">
        <Setter Property="Padding" Value="0,20,0,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="{TemplateBinding Title}"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Actions}"
                                                  VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                            <TextBlock Classes="description" Text="{TemplateBinding Description}"
                                       IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          IsVisible="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- <ui:SettingRow Label="Karaoke" Description="…"><ToggleSwitch …/></ui:SettingRow> -->
    <ControlTheme x:Key="{x:Type ui:SettingRow}" TargetType="ui:SettingRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Classes="fieldLabel" Text="{TemplateBinding Label}" TextWrapping="Wrap"/>
                        <TextBlock Classes="caption" Text="{TemplateBinding Description}"
                                   IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <ContentPresenter Grid.Column="1" Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
