<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="HorizonRadio.Sdk.UI.Theme.HorizonRadioTheme">

    <!-- The whole look of Horizon Radio, for the app's Application.Styles:
         <theme:HorizonRadioTheme/>. Plugin pages are drawn with it too. -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://HorizonRadio.Sdk.UI/Theme/Colors.axaml"/>
                <ResourceInclude Source="avares://HorizonRadio.Sdk.UI/Controls/Layout.axaml"/>
                <ResourceInclude Source="avares://HorizonRadio.Sdk.UI/Controls/Status.axaml"/>
                <ResourceInclude Source="avares://HorizonRadio.Sdk.UI/Controls/Inputs.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <shadui:ShadTheme/>
    <!-- Registers the MaterialIcon control template and its icon data; without it every
         MaterialIcon renders as an empty box. -->
    <materialIcons:MaterialIconStyles/>
    <StyleInclude Source="avares://HorizonRadio.Sdk.UI/Theme/Typography.axaml"/>
    <StyleInclude Source="avares://HorizonRadio.Sdk.UI/Theme/Surfaces.axaml"/>
    <StyleInclude Source="avares://HorizonRadio.Sdk.UI/Theme/Window.axaml"/>
</Styles>
