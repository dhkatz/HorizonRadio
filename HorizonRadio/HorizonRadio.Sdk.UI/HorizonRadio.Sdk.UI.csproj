<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The app's look, shared by the app and plugin pages: the theme (ShadUI, Material icons, our
    color tokens and text styles) and the controls pages are built from. Plugins with pages
    reference this rather than ShadUI or Avalonia directly, so they get the same versions as the
    app (the host and its plugins share one copy of each UI assembly).
    See docs/modular-architecture.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="ShadUI" Version="0.2.3" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>

</Project>
