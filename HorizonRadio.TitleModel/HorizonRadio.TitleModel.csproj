<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HorizonRadio.Core\HorizonRadio.Core.csproj" />
  </ItemGroup>

  <!-- The native ML dependency is isolated here so it doesn't bloat Core (or its test runs).
       LLamaSharp.Backend.Cpu ships the llama.cpp native binaries; swapping it for a CUDA/Vulkan
       backend package enables GPU with no code change (the GpuLayerCount knob is already wired). -->
  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>

</Project>
