<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spotify metadata plugin. References the host (Core) for shared helpers, the SDK (Abstractions,
    transitively), SpotifyAPI.Web (transitively via Core), and — when no app credentials are set —
    the connected Spotify source's SpotifyRuntime (in Core) to ride on its Web API client.
    No InternalsVisibleTo: nothing internal is unit-tested.

    NOTE: the SpotifyRuntime static reach is a Sources-layer coupling; it'll be replaced by a
    host-mediated shared connection when the Source plugins are split (where SpotifyRuntime is
    reworked). For now this is the same coupling as before, just across the assembly boundary.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HorizonRadio.Core\HorizonRadio.Core.csproj" />
  </ItemGroup>

</Project>
